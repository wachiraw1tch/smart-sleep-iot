{
  "version": 1,
  "author": "Smart Sleep Node",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-mpu6050", "id": "mpu1", "top": -40, "left": 140, "attrs": {} },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_hr",
      "top": 20,
      "left": -130,
      "attrs": { "label": "Heart Rate (KY-039)" }
    },
    {
      "type": "wokwi-slide-switch",
      "id": "sw_bed",
      "top": 130,
      "left": -110,
      "attrs": { "label": "On Bed Sensor" }
    }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],
    [ "mpu1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "mpu1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "mpu1:SCL", "esp:D22", "blue", [ "v0" ] ],
    [ "mpu1:SDA", "esp:D21", "green", [ "v0" ] ],
    [ "pot_hr:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "pot_hr:GND", "esp:GND.2", "black", [ "v0" ] ],
    [ "pot_hr:SIG", "esp:D34", "orange", [ "v0" ] ],
    [ "sw_bed:1", "esp:GND.2", "black", [ "v0" ] ],
    [ "sw_bed:2", "esp:D35", "purple", [ "v0" ] ]
  ],
  "dependencies": {}
}